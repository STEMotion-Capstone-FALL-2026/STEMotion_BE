# Required: test uses IP/HTTP paths; prod uses domains/TLS. Example: prod
DEPLOY_MODE=test
# Host bind; VPS uses 0.0.0.0, local smoke uses 127.0.0.1. Example: 127.0.0.1
CADDY_BIND_IP=0.0.0.0
# Public HTTP port; VPS must use 80. Example local: 18080
HTTP_PORT=80
# Public HTTPS port; VPS must use 443. Example local: 18443
HTTPS_PORT=443
# Required in prod: DNS A record to the VPS, no scheme/path. Example: ai.stemotion.example
AI_DOMAIN=ai.example.invalid
# Required in prod: distinct worker DNS A record. Example: worker.stemotion.example
WORKER_DOMAIN=worker.example.invalid
# Required in prod: real ACME contact address. Example: ops@your-domain.vn
ACME_EMAIL=ops@example.invalid
# Required: same random 32+ char hex/base64url secret in BE and AI; generate privately, e.g. openssl rand -hex 32
AI_SERVICE_SHARED_KEY=
# Required for real drafting/production readiness; blank allowed for health-only local smoke. Example: owner-provided key
OPENAI_API_KEY=
# Draft snapshot (currently deprecated; confirm account availability before real API use). Example: gpt-4o-2024-08-06
OPENAI_MODEL_DRAFT=gpt-4o-2024-08-06
# Light-task snapshot; no real API used in Phase A. Example: gpt-4o-mini-2024-07-18
OPENAI_MODEL_LIGHT=gpt-4o-mini-2024-07-18
# BE-only configuration reference, must also be set on Render BE; rates checked 2026-10-16. Example: {} means unknown
AI_PRICING_JSON={"gpt-4o-2024-08-06":{"inputPerMillion":2.5,"outputPerMillion":10,"version":"openai-standard-text-2026-10-16"},"gpt-4o-mini-2024-07-18":{"inputPerMillion":0.15,"outputPerMillion":0.6,"version":"openai-standard-text-2026-10-16"}}
# Operator target only; NOT an implemented spend cap. Example: 20
AI_MONTHLY_BUDGET_USD=
# Host directory containing faster-whisper-small/; transfer existing verified weights, no startup downloads. Example: ./models
WHISPER_HOST_DIR=./models
# Required for deployment; optional is only a deliberately incomplete liveness smoke. Example: required
WHISPER_STARTUP_MODE=required
# Confidence default 0.05; earlier local Vietnamese fixture needed 0.03, not production-wide calibration. Example: 0.05
WHISPER_MIN_WORD_PROBABILITY=0.05
# Local versioned AI image tag; retain old tags for rollback. Example: stemotion-ai:069f2f1
AI_IMAGE=stemotion-ai:hetzner-phase-a
# Worker image tag to build from frozen sibling source. Example: stemotion-worker:release-20261016
WORKER_IMAGE=stemotion-worker:hetzner-phase-a
# Required build context: sibling RENDER with its existing Dockerfile. Example: ../STEMotion_RENDER
WORKER_BUILD_CONTEXT=../STEMotion_RENDER
# Required additional named context used by worker Dockerfile. Example: ../STEMotion_FE
WORKER_FE_BUILD_CONTEXT=../STEMotion_FE
# Required: same 32+ char hex/base64url worker key in Render BE, passed as X-Api-Key. Example: privately generated hex
RENDER_SERVICE_KEY=
# Required: 32+ char hex/base64url Redis AUTH secret, never published as a host port. Example: openssl rand -hex 32
REDIS_PASSWORD=
# Required: externally reachable BE callback, not the worker URL; prod must use HTTPS. Example: https://your-be.onrender.com/api/v1/render/callback
API_CALLBACK_URL=https://your-be.example.invalid/api/v1/render/callback
# Required: test http://IP/worker/videos; prod https://WORKER_DOMAIN/videos. Example: https://worker.your-domain.vn/videos
WORKER_PUBLIC_BASE_URL=http://127.0.0.1/worker/videos
# TTS costs disabled in local tests; enable only with approved credentials/budget. Example: false
USE_TTS=false
# Existing worker provider, fpt or google. Example: fpt
TTS_PROVIDER=fpt
# Required only when enabling paid FPT narration; keep blank in Phase A. Example: owner-provided FPT.AI key
TTS_API_KEY=
# Existing FPT voice id. Example: banmai
TTS_VOICE=banmai
# Existing FPT speed setting. Example: 0
TTS_SPEED=0
# Documentation only: compose FIXES BullMQ job concurrency at 1 (not a cross-service mutex). Example: 1
RENDER_CONCURRENCY=1
# Documentation only: compose FIXES Remotion frame concurrency at 1. Example: 1
RENDER_FRAME_CONCURRENCY=1
