{$AI_DOMAIN} {
	reverse_proxy ai-service:8000
}
{$WORKER_DOMAIN} {
	@public path /health /videos/* /audio/* /images/* /render-status/*
	handle @public {
		reverse_proxy worker:4000
	}
	@authorized header X-Api-Key {$RENDER_SERVICE_KEY}
	handle @authorized {
		reverse_proxy worker:4000
	}
	respond "Worker key required" 401
}
