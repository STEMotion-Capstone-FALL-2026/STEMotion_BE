  "components": {
    "schemas": {
      "ActionInput": {
        "properties": {
          "scriptText": {
            "type": "string",
            "maxLength": 60000,
            "minLength": 1,
            "title": "Scripttext"
          },
          "subject": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "Math",
                  "Physics",
                  "Chemistry",
                  "Biology",
                  "ComputerScience",
                  "CS"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Subject"
          },
          "gradeLevel": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 64
              },
              {
                "type": "null"
              }
            ],
            "title": "Gradelevel"
          },
          "action": {
            "type": "string",
            "enum": [
              "resegment",
              "grade",
              "extract",
              "terms"
            ],
            "title": "Action"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "scriptText",
          "action"
        ],
        "title": "ActionInput"
      },
      "AnalysisInput": {
        "properties": {
          "scriptText": {
            "type": "string",
            "maxLength": 60000,
            "minLength": 1,
            "title": "Scripttext"
          },
          "subject": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "Math",
                  "Physics",
                  "Chemistry",
                  "Biology",
                  "ComputerScience",
                  "CS"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Subject"
          },
          "gradeLevel": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 64
              },
              {
                "type": "null"
              }
            ],
            "title": "Gradelevel"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "scriptText"
        ],
        "title": "AnalysisInput"
      },
      "Body_align_audio_transcribe_align_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          },
          "text": {
            "type": "string",
            "maxLength": 10000,
            "minLength": 1,
            "title": "Text"
          },
          "language": {
            "type": "string",
            "maxLength": 8,
            "minLength": 2,
            "title": "Language",
            "default": "vi"
          }
        },
        "type": "object",
        "required": [
          "file",
          "text"
        ],
        "title": "Body_align_audio_transcribe_align_post"
      },
      "GenerationRequest": {
        "properties": {
          "systemInstruction": {
            "type": "string",
            "maxLength": 20000,
            "minLength": 1,
            "title": "Systeminstruction"
          },
          "prompt": {
            "type": "string",
            "maxLength": 80000,
            "minLength": 1,
            "title": "Prompt"
          },
          "responseSchema": {
            "additionalProperties": true,
            "type": "object",
            "title": "Responseschema"
          },
          "task": {
            "type": "string",
            "enum": [
              "generate",
              "resegment",
              "grade",
              "extract",
              "terms"
            ],
            "title": "Task",
            "default": "generate"
          }
        },
        "type": "object",
        "required": [
          "systemInstruction",
          "prompt",
          "responseSchema"
        ],
        "title": "GenerationRequest"
      },
      "GenerationResponse": {
        "properties": {
          "result": {
            "additionalProperties": true,
            "type": "object",
            "title": "Result"
          },
          "model": {
            "type": "string",
            "title": "Model"
          },
          "elapsedMs": {
            "type": "integer",
            "title": "Elapsedms"
          },
          "inputTokens": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Inputtokens"
          },
          "outputTokens": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Outputtokens"
          },
          "totalTokens": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Totaltokens"
          }
        },
        "type": "object",
        "required": [
          "result",
          "model",
          "elapsedMs"
        ],
        "title": "GenerationResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ScriptInput": {
        "properties": {
          "topic": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Topic"
          },
          "subject": {
            "type": "string",
            "enum": [
              "Math",
              "Physics",
              "Chemistry",
              "Biology",
              "ComputerScience",
              "CS"
            ],
            "title": "Subject"
          },
          "gradeLevel": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Gradelevel"
          },
          "targetDurationSec": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 300.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Targetdurationsec"
          },
          "narrativeBrief": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500
              },
              {
                "type": "null"
              }
            ],
            "title": "Narrativebrief"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "topic",
          "subject",
          "gradeLevel"
        ],
        "title": "ScriptInput"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
