# Process environment only; never commit a populated .env.
AI_SERVICE_SHARED_KEY=
# AI_SERVICE_KEY is the legacy alias; prefer the shared name in both services.
AI_PROVIDER=openai
# Optional task-specific routing; empty inherits AI_PROVIDER. Each selected provider needs its own key.
AI_STORYBOARD_PROVIDER=
AI_REVIEW_PROVIDER=
# Options: openai | anthropic | gemini. Keys belong to THIS ai-service process.
# Claude Opus is Anthropic, not an OpenAI/ChatGPT model.
ANTHROPIC_API_KEY=
# Choose IDs allowed on your Claude API account; example: claude-opus-5-5.
ANTHROPIC_MODEL_DRAFT=
ANTHROPIC_MODEL_LIGHT=
ANTHROPIC_API_VERSION=2023-06-01
ANTHROPIC_MAX_OUTPUT_TOKENS=8192
OPENAI_API_KEY=
# Optional; leave empty for models which do not accept temperature.
OPENAI_TEMPERATURE=
OPENAI_MODEL_DRAFT=gpt-4o-2024-08-06
OPENAI_MODEL_LIGHT=gpt-4o-mini-2024-07-18
# Explicit service-provider rollback only; not a silent fallback.
GEMINI_API_KEY=
GEMINI_MODEL=
# Force-align known narration against per-scene audio. Pre-provision model weights.
WHISPER_MODEL=faster-whisper-small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_MODEL_DIR=/models/faster-whisper-small
WHISPER_LOCAL_FILES_ONLY=true
WHISPER_MIN_WORD_PROBABILITY=0.05
WHISPER_STARTUP_MODE=required
WHISPER_STARTUP_TIMEOUT_SEC=90
UVICORN_WORKERS=1
PORT=8000
OMP_NUM_THREADS=1
# BE-only monitoring configuration. NOT enforced by ai-service.
# USD / 1M standard text tokens, verified 2026-10-16; no cached/batch discounts.
# https://developers.openai.com/api/docs/models/gpt-4o
# https://developers.openai.com/api/docs/models/gpt-4o-mini
# Empty/unset pricing in BE => unknown cost (null). Both snapshots currently marked deprecated.
AI_PRICING_JSON={"gpt-4o-2024-08-06":{"inputPerMillion":2.5,"outputPerMillion":10,"version":"openai-standard-text-2026-10-16"},"gpt-4o-mini-2024-07-18":{"inputPerMillion":0.15,"outputPerMillion":0.6,"version":"openai-standard-text-2026-10-16"}}
AI_USAGE_ZONE=Asia/Ho_Chi_Minh
# Reserved/documentary budget target; no budget enforcement implemented.
AI_MONTHLY_BUDGET_USD=
