# Process environment only; never commit a populated .env.
AI_SERVICE_SHARED_KEY=
# AI_SERVICE_KEY is the legacy alias; prefer the shared name in both services.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL_DRAFT=gpt-4.1
OPENAI_MODEL_LIGHT=gpt-4o-mini
# Explicit service-provider rollback only; not a silent fallback.
GEMINI_API_KEY=
GEMINI_MODEL=
# Force-align known narration against per-scene audio. Pre-provision model weights.
WHISPER_MODEL=faster-whisper-small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_MODEL_DIR=/models/faster-whisper-small
WHISPER_LOCAL_FILES_ONLY=true
WHISPER_MIN_WORD_PROBABILITY=0.05
WHISPER_STARTUP_MODE=required
WHISPER_STARTUP_TIMEOUT_SEC=90
UVICORN_WORKERS=1
PORT=8000
OMP_NUM_THREADS=1
# BE-only monitoring configuration. NOT enforced by ai-service.
# USD / 1M standard text tokens, verified 2026-10-17; no cached/batch discounts.
# https://developers.openai.com/api/docs/models/gpt-4.1
# https://developers.openai.com/api/docs/models/gpt-4o-mini
# Empty/unset pricing in BE => unknown cost (null). The requested models are also marked deprecated.
AI_PRICING_JSON={"gpt-4.1":{"inputPerMillion":2,"outputPerMillion":8,"version":"openai-standard-text-2026-10-17"},"gpt-4.1-2025-04-14":{"inputPerMillion":2,"outputPerMillion":8,"version":"openai-standard-text-2026-10-17"},"gpt-4o-mini":{"inputPerMillion":0.15,"outputPerMillion":0.6,"version":"openai-standard-text-2026-10-17"},"gpt-4o-mini-2024-07-18":{"inputPerMillion":0.15,"outputPerMillion":0.6,"version":"openai-standard-text-2026-10-17"}}
AI_USAGE_ZONE=Asia/Ho_Chi_Minh
# Reserved/documentary budget target; no budget enforcement implemented.
AI_MONTHLY_BUDGET_USD=
