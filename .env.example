# Copy file này thành .env rồi điền giá trị thật.
# File .env đã nằm trong .gitignore — TUYỆT ĐỐI không commit nó.

# ---- Database -------------------------------------------------------------
# Khớp với docker-compose.yml (container map 5432 -> 5433 để không đụng
# Postgres cài sẵn trên máy). Dùng docker thì để nguyên 3 dòng này.
DB_URL=jdbc:postgresql://localhost:5433/stemotion_db
DB_USERNAME=postgres
DB_PASSWORD=postgres

# ---- Bảo mật --------------------------------------------------------------
# Chuỗi bất kỳ, TỐI THIỂU 32 ký tự. Mỗi người tự sinh một chuỗi riêng.
# Đổi chuỗi này sẽ làm mọi token đang đăng nhập hết hiệu lực.
JWT_SECRET=doi-chuoi-nay-thanh-cua-rieng-ban-it-nhat-32-ky-tu

# Origin của FE được phép gọi API. Vite dev mặc định chạy port 3000.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Google AI Studio (Gemini) -------------------------------------------
# Lấy key tại https://aistudio.google.com/apikey — MỖI NGƯỜI DÙNG KEY RIÊNG.
# Để trống thì app vẫn chạy bình thường, chỉ các endpoint /api/v1/ai/** trả 503.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# ---- Render service (Node + Remotion) ------------------------------------
# Để trống RENDER_SERVICE_KEY khi dev ở máy cá nhân (tắt xác thực).
# Nếu điền thì phải trùng với RENDER_SERVICE_KEY bên STEMotion_RENDER/.env
RENDER_SERVICE_URL=http://localhost:4000
RENDER_SERVICE_KEY=
RENDER_CALLBACK_URL=http://localhost:8080/api/v1/render/callback

# ---- Xuất bản -------------------------------------------------------------
EMBED_BASE_URL=http://localhost:3000/embed
