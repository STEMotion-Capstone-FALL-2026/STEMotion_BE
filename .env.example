# Copy file này thành .env rồi điền giá trị thật.
# File .env đã nằm trong .gitignore — TUYỆT ĐỐI không commit nó.

# ---- Database -------------------------------------------------------------
# Khớp với docker-compose.yml (container map 5432 -> 5433 để không đụng
# Postgres cài sẵn trên máy). Dùng docker thì để nguyên 3 dòng này.
DB_URL=jdbc:postgresql://localhost:5433/stemotion_db
DB_USERNAME=postgres
DB_PASSWORD=postgres

# ---- Bảo mật --------------------------------------------------------------
# Chuỗi bất kỳ, TỐI THIỂU 32 ký tự. Mỗi người tự sinh một chuỗi riêng.
# Đổi chuỗi này sẽ làm mọi token đang đăng nhập hết hiệu lực.
JWT_SECRET=doi-chuoi-nay-thanh-cua-rieng-ban-it-nhat-32-ky-tu

# Origin của FE được phép gọi API. Dấu * khớp mọi port, nên Vite có tự
# nhảy sang port khác (3001, 3002...) khi 3000 bận thì vẫn chạy được.
CORS_ORIGINS=http://localhost:*,http://127.0.0.1:*

# ---- Google AI Studio (Gemini) -------------------------------------------
# Lấy key tại https://aistudio.google.com/apikey — MỖI NGƯỜI DÙNG KEY RIÊNG.
# Để trống thì app vẫn chạy bình thường, chỉ các endpoint /api/v1/ai/** trả 503.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# ---- Render service (Node + Remotion) ------------------------------------
# Để trống RENDER_SERVICE_KEY khi dev ở máy cá nhân (tắt xác thực).
# Nếu điền thì phải trùng với RENDER_SERVICE_KEY bên STEMotion_RENDER/.env
RENDER_SERVICE_URL=http://localhost:4000
RENDER_SERVICE_KEY=
RENDER_CALLBACK_URL=http://localhost:8080/api/v1/render/callback

# ---- Xuất bản -------------------------------------------------------------
EMBED_BASE_URL=http://localhost:3000/embed

# Required only for local Docker Compose MinIO; generate privately.
MINIO_ROOT_PASSWORD=

# AI service local settings (keys remain private).
# OPENAI_MODEL_* below configure the Python service, not the Spring BE.
# Canonical names are OPENAI_MODEL_DRAFT / OPENAI_MODEL_LIGHT, not AI_MODEL_*.
AI_SERVICE_MODE=remote
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_SHARED_KEY=
OPENAI_MODEL_DRAFT=gpt-4.1
OPENAI_MODEL_LIGHT=gpt-4o-mini
# BE standard text USD per 1M tokens, checked 2026-10-17; excludes cached/batch discounts.
# Sources: https://developers.openai.com/api/docs/models/gpt-4.1 and /gpt-4o-mini
# The requested models are also marked deprecated; verify availability before future real API use.
AI_PRICING_JSON={"gpt-4.1":{"inputPerMillion":2,"outputPerMillion":8,"version":"openai-standard-text-2026-10-17"},"gpt-4.1-2025-04-14":{"inputPerMillion":2,"outputPerMillion":8,"version":"openai-standard-text-2026-10-17"},"gpt-4o-mini":{"inputPerMillion":0.15,"outputPerMillion":0.6,"version":"openai-standard-text-2026-10-17"},"gpt-4o-mini-2024-07-18":{"inputPerMillion":0.15,"outputPerMillion":0.6,"version":"openai-standard-text-2026-10-17"}}
# Compose selects the provisioned ./models subfolder.
WHISPER_MODEL=faster-whisper-small
# Google Sign-In (OAuth 2.0 web client id from Google Cloud Console). Empty = off.
# Only accounts an admin already created can sign in; the FE needs the same id
# as VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=

# BE: timezone for AI usage daily grouping; optional default shown.
AI_USAGE_ZONE=Asia/Ho_Chi_Minh
# BE: dashboard budget target in USD; optional, not an enforced spending limit.
AI_MONTHLY_BUDGET_USD=
# BE: worker-to-BE alignment credential, required only for internal worker alignment.
AI_ALIGNMENT_WORKER_KEY=
