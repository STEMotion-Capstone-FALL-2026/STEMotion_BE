+package com.stemotion.domain.stem;
+import com.fasterxml.jackson.databind.*;
+import com.stemotion.core.exception.ApiException;
+import org.springframework.jdbc.core.JdbcTemplate;
+import org.springframework.stereotype.Repository;
+import org.springframework.boot.autoconfigure.condition.ConditionalOnProperty;
+import java.util.*;
+@Repository
+@ConditionalOnProperty(name="app.stem.enabled",havingValue="true")
+public class StemRepository {
+ private final JdbcTemplate jdbc;
+ private final ObjectMapper json;
+ public StemRepository(JdbcTemplate jdbc,ObjectMapper json){this.jdbc=jdbc;this.json=json.copy().enable(DeserializationFeature.FAIL_ON_UNKNOWN_PROPERTIES);}
+ // Access through methods so Spring repository proxies delegate to the initialized target.
+ public JdbcTemplate jdbc(){return jdbc;}
+ public ObjectMapper json(){return json;}
+ public String encode(Object data){try{return json.writeValueAsString(data);}catch(Exception e){throw ApiException.badRequest("Invalid STEM JSON");}}
+ public <T>T decode(String text,Class<T> type){try{return json.readValue(text,type);}catch(Exception e){throw ApiException.badRequest("Invalid STEM JSON for "+type.getSimpleName());}}
+ public String id(){return UUID.randomUUID().toString();}
+ public Map<String,Object> brief(String version){return jdbc.queryForList("select * from stem_briefs where version_id=?",version).stream().findFirst().orElse(null);}
+ public String text(Map<String,Object> row,String key){return row.get(key)==null?null:row.get(key).toString();}
+ public int number(Map<String,Object> row,String key){return ((Number)row.get(key)).intValue();}
+ public List<StemDtos.Evidence> evidence(String brief){return jdbc.query("select * from stem_evidence where brief_id=? and not retired order by id",(rs,n)->new StemDtos.Evidence(rs.getString("id"),rs.getString("original_scene_id"),rs.getString("task_key"),rs.getString("objective_key"),rs.getString("component"),rs.getString("explanation")),brief);}
+ public StemModels.WorkspaceMode settings(String workspace){
+  return jdbc.query("select * from stem_settings where workspace_id=?",(rs,n)->new StemModels.WorkspaceMode(workspace,rs.getInt("revision"),rs.getString("mode"),Arrays.asList(decode(rs.getString("policy_ids"),String[].class)),rs.getString("default_policy_id")),workspace).stream().findFirst().orElse(new StemModels.WorkspaceMode(workspace,0,"OFF",List.of(),null));
+ }
+ public void audit(String actor,String target,String event,Object payload){jdbc.update("insert into stem_audit(id,actor_id,target,event,payload) values(?,?,?,?,?::jsonb)",id(),actor,target,event,encode(payload));}
