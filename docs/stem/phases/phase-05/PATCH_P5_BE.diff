+        Set<String> fields=Set.of("id","kind","slot","text","items","latex","icon","icons","value","unit","points","question","options","answer","from","to","pose","at","until","revealAt","strikeAt","motion","emphasis","tone","x","y","w","h","scale","fontSize","hidden");
